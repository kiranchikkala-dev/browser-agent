{
  "name": "browser-agent",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "worker": "npm run start -w @app/worker",
    "cli": "tsx scripts/cli.ts",
    "test:agent": "node --import tsx --test packages/agent/src/schemas/url.test.ts packages/browser/src/waiting.test.ts packages/agent/src/tools/search.test.ts",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "db:push": "drizzle-kit push --config packages/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config packages/db/drizzle.config.ts",
    "browser:smoke": "tsx scripts/browser-smoke.ts"
  },
  "workspaces": [
    "packages/*",
    "worker",
    "@app/browser"
  ],
  "dependencies": {
    "@app/db": "*",
    "@app/shared": "*",
    "@base-ui/react": "^1.8.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.6",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.3",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
